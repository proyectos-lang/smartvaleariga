# ─────────────────────────────────────────────────────────────
# ARIGA · variables de entorno
# Copia este archivo a .env.local y llena los valores.
# .env.local NUNCA se sube al repositorio.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
# Estas dos viajan al navegador: son públicas por diseño y RLS las respalda.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: ignora RLS. Solo en el servidor.
# En Vercel debe marcarse como "Sensitive" y jamás prefijarse con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio. Es la base de los enlaces que se codifican en el QR,
# así que en producción debe ser el dominio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
