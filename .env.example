# ─────────────────────────────────────────────────────────────
# ARIGA · variables de entorno
# Copia este archivo a .env.local y llena los valores.
# .env.local NUNCA se sube al repositorio.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública. Se usa la `sb_publishable_…` si está presente; si no, la anon.
# Ambas viajan al navegador: son públicas por diseño y RLS es la protección.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: ignora RLS. Solo en el servidor.
# En Vercel debe marcarse como "Sensitive" y jamás prefijarse con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# El esquema de Postgres de esta aplicación (`smartvale`) es una constante en
# src/lib/supabase/env.ts, no una variable de entorno: forma parte de los tipos
# que genera `npm run db:types`.

# URL pública del sitio. Es la base de los enlaces que se codifican en el QR,
# así que en producción debe ser el dominio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
