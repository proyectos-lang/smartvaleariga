{
  "name": "arigasmartvale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "db:check": "node --env-file=.env.local scripts/verificar-supabase.mjs",
    "db:bundle": "node scripts/empaquetar-migraciones.mjs",
    "usuarios:crear": "node --env-file=.env.local scripts/crear-usuario.mjs",
    "marca:generar": "node scripts/generar-marca.mjs",
    "test:negocio": "node --env-file=.env.local scripts/probar-negocio.mjs",
    "db:link": "supabase link",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:types": "supabase gen types typescript --linked --schema smartvale > src/lib/supabase/types.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.6.1",
    "@supabase/supabase-js": "^2.112.3",
    "@zxing/browser": "^0.2.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-qr-code": "^2.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "supabase": "^2.114.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
